# Backend environment configuration
#
# Copy this file to `.env` in this directory (dispatch-platform/backend/.env)
# and fill in real values for local development. `.env` is gitignored and
# must never be committed. This file documents every variable actually read
# by src/config/env.ts — nothing here is aspirational.

# --- Database -----------------------------------------------------------
# Required. Prisma datasource URL. Local dev uses SQLite against the
# committed schema at prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Required. Secret used to sign/verify JWTs (see src/utils/jwt.ts).
# Use a long, random, unique value per environment. Never reuse the example
# below outside a throwaway local setup, and never commit a real one.
JWT_SECRET="replace-with-a-long-random-local-dev-secret"

# Optional. How long issued JWTs remain valid. Default: 30d.
# JWT_EXPIRES_IN=30d

# Optional. The fixed OTP code accepted for every phone number in
# non-production dev/test environments. Default: 123456.
# DEV_OTP_CODE=123456

# Optional. How long an issued OTP stays valid, in seconds. Default: 300.
# OTP_TTL_SECONDS=300

# --- Server -----------------------------------------------------------------
# Optional. HTTP port the Express server listens on. Default: 8002.
# PORT=8002

# Optional. Prefix under which all API routes are mounted. Default: /api.
# API_PREFIX=/api

# Optional. Standard Node environment flag. Affects logging verbosity,
# and whether the OTP-request response echoes the dev OTP code back to the
# caller (only suppressed when this is exactly "production").
# NODE_ENV=development

# --- CORS -----------------------------------------------------------------
# Optional. Allowed CORS origin. "*" (the default) reflects any request
# origin. Set this to your actual frontend origin outside local dev.
# CORS_ORIGIN=*

# --- Dispatch engine tuning -------------------------------------------------
# Optional. Maximum distance (km) a worker can be from a job to be
# considered a dispatch candidate. Default: 25.
# DISPATCH_MAX_RADIUS_KM=25

# Optional. Maximum number of ranked candidates to create JobOffer rows for
# per dispatch run. Default: 15.
# DISPATCH_MAX_CANDIDATES=15
