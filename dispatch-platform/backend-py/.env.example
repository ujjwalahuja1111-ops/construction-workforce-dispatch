# --- App ------------------------------------------------------------------
NODE_ENV=development
PORT=8003
API_PREFIX=/api

# --- Database ---------------------------------------------------------------
# SQLAlchemy-style URL. Local dev/test: sqlite. Real environments: swap for
# postgresql+psycopg://user:pass@host:5432/dbname (this service is
# Postgres-ready — no code change needed, only this URL).
DATABASE_URL=sqlite:///./dev.db

# --- Auth ---------------------------------------------------------------
# Set this to the SAME value as dispatch-platform/backend/.env's JWT_SECRET
# during the migration window, so tokens verify on both services.
JWT_SECRET=replace-with-a-long-random-local-dev-secret
JWT_EXPIRES_IN_DAYS=30

# --- CORS ---------------------------------------------------------------
CORS_ORIGIN=*
