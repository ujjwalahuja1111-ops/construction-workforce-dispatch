# Frontend (Expo) environment configuration
#
# Copy this file to `.env` in this directory (frontend/.env) and fill in a
# real value for local development. `.env` is gitignored and must never be
# committed. This file documents every variable actually read by the app
# (see src/api/client.ts) — nothing here is aspirational.

# Required. Base URL of the backend API (dispatch-platform/backend), with no
# trailing slash and no /api suffix — the client appends /api itself.
#
# - Expo Go on a physical device or another machine's emulator: use your
#   computer's LAN IP, not localhost, e.g. http://192.168.1.23:8002
# - iOS Simulator / Android Emulator on the same machine as the backend:
#   http://localhost:8002 usually works.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8002
