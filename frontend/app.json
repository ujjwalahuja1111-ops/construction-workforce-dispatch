{
  "expo": {
    "name": "Dispatch Worker",
    "slug": "dispatch-worker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dispatch",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergent.appforge.jhfywt",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Verify site check-in and match nearby jobs",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Verify site check-in and match nearby jobs"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.appforge.jhfywt",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Verify site check-in and match nearby jobs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
